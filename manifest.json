{
  "manifest_version": 3,
  "name": "Auto Reject Cookies",
  "version": "2.0.1",
  "minimum_chrome_version": "119",
  "description": "Tries to reject optional cookie consent using supported consent managers and cautious multilingual detection.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["consent-rules.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Reject Cookies"
  }
}
